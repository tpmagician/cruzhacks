# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Optional: port for the local server (default 3000)
PORT=3000

# Optional: word-for-word transcription of spoken answers, used to count filler
# words ("um", "uh") that browser dictation drops. Uses Deepgram when this key is
# set, otherwise a Gemini audio model with GEMINI_API_KEY.
# DEEPGRAM_API_KEY=
# TRANSCRIBE_MODEL=gemini-3.8-flash
